<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>AutoTax • Mobile Automotive GST & TDS Calculator</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        carDark: '#080C15',
                        carCard: '#111827',
                        carSurface: '#1E293B',
                        carBorder: '#273549',
                        accentCyan: '#00F0FF',
                        accentGreen: '#10B981',
                        accentOrange: '#F59E0B'
                    },
                    boxShadow: {
                        'neon-cyan': '0 0 25px -5px rgba(0, 240, 255, 0.3)',
                        'neon-green': '0 0 25px -5px rgba(16, 185, 129, 0.3)'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #080C15;
            color: #F8FAFC;
            -webkit-tap-highlight-color: transparent;
        }

        /* Smooth touch scrolling */
        html {
            scroll-behavior: smooth;
        }

        /* Clean custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #080C15;
        }
        ::-webkit-scrollbar-thumb {
            background: #273549;
            border-radius: 9999px;
        }

        /* Print formatting */
        @media print {
            body {
                background: #ffffff !important;
                color: #000000 !important;
            }
            header, footer, #mobileStickyBar, .no-print {
                display: none !important;
            }
            .print-clean {
                border: 1px solid #ccc !important;
                background: white !important;
                color: black !important;
                box-shadow: none !important;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between p-3 sm:p-5 md:p-8 pb-28 lg:pb-8 max-w-7xl mx-auto">

    <!-- Top Dashboard Header with Custom SVG Logo -->
    <header class="w-full bg-carCard/90 backdrop-blur-md border border-carBorder rounded-2xl p-3.5 sm:p-5 mb-4 sm:mb-6 shadow-2xl flex flex-col sm:flex-row items-center justify-between gap-3.5 sticky top-2 z-40">
        
        <!-- Brand / Custom SVG Logo -->
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <!-- Custom Aerodynamic Car & Tax Emblem SVG -->
            <div class="relative flex-shrink-0 w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-br from-slate-900 to-carCard border border-accentCyan/40 flex items-center justify-center shadow-neon-cyan overflow-hidden group">
                <svg class="w-8 h-8 drop-shadow-[0_0_8px_rgba(0,240,255,0.7)]" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="neonGlow" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#00F0FF" />
                            <stop offset="100%" stop-color="#10B981" />
                        </linearGradient>
                    </defs>
                    <!-- Shield outline -->
                    <polygon points="50,6 88,24 88,68 50,94 12,68 12,24" stroke="url(#neonGlow)" stroke-width="4.5" fill="none" stroke-linejoin="round" opacity="0.45" />
                    <!-- Aerodynamic Sports Coupe Silhouette -->
                    <path d="M 24 64 C 28 64 31 57 39 56 C 44 47 52 42 66 42 C 76 42 81 48 83 54 C 86 54 88 58 88 62 C 88 64 86 65 82 65 C 80 61 75 58 70 58 C 65 58 60 61 58 65 L 42 65 C 40 61 35 58 30 58 C 26 58 24 61 24 64 Z" fill="url(#neonGlow)" />
                    <!-- Wheels (Neon Speed Circles) -->
                    <circle cx="30" cy="64" r="5" fill="#080C15" stroke="#00F0FF" stroke-width="2.5" />
                    <circle cx="70" cy="64" r="5" fill="#080C15" stroke="#10B981" stroke-width="2.5" />
                    <!-- Rupee / Percentage Tachometer Dash -->
                    <path d="M 45 28 L 57 28 M 45 34 L 55 34 M 45 28 C 53 28 54 39 46 40 L 56 50" stroke="#00F0FF" stroke-width="2.5" stroke-linecap="round" />
                    <!-- Speed Slash -->
                    <line x1="20" y1="36" x2="35" y2="36" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" opacity="0.8" />
                </svg>
            </div>

            <!-- Title & Subtitle -->
            <div class="leading-tight flex-1">
                <div class="flex items-center gap-2">
                    <span class="text-lg sm:text-2xl font-extrabold tracking-tight text-white">AUTOTAX</span>
                    <span class="text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-full bg-accentCyan/15 text-accentCyan border border-accentCyan/30 tracking-wider">PRO MOBILE</span>
                </div>
                <p class="text-[11px] sm:text-xs text-slate-400">Automotive GST & TDS Engine</p>
            </div>

            <!-- Mobile Reset Button icon only -->
            <button onclick="resetCalculator()" aria-label="Reset Calculator" class="sm:hidden w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 flex items-center justify-center active:scale-95 transition">
                <i class="fa-solid fa-rotate-right"></i>
            </button>
        </div>
        
        <!-- Controls & Status Badge -->
        <div class="flex items-center justify-between sm:justify-end gap-2.5 w-full sm:w-auto">
            <div id="statusBadge" class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold text-slate-300 flex items-center justify-center sm:justify-start gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse" id="statusDot"></span>
                <span id="statusText">Select States</span>
            </div>
            
            <button onclick="resetCalculator()" class="hidden sm:flex px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs md:text-sm font-semibold transition active:scale-95 items-center gap-2 cursor-pointer">
                <i class="fa-solid fa-rotate-right"></i> Reset
            </button>
        </div>
    </header>

    <!-- Main Dashboard Grid -->
    <main class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 flex-grow">
        
        <!-- Left Panel: Inputs & Configuration (7 cols) -->
        <section class="lg:col-span-7 bg-carCard border border-carBorder rounded-2xl p-4 sm:p-6 shadow-xl flex flex-col justify-between">
            <div class="space-y-4 sm:space-y-5">
                
                <!-- Section Header -->
                <div class="flex items-center justify-between pb-3 border-b border-carBorder">
                    <h2 class="text-sm sm:text-base font-semibold text-white flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-accentCyan"></i> Transaction Parameters
                    </h2>
                    <!-- Quick Same State Button -->
                    <button type="button" onclick="setSameStateQuick()" class="text-xs bg-accentCyan/10 hover:bg-accentCyan/20 text-accentCyan border border-accentCyan/30 px-2.5 py-1 rounded-lg transition active:scale-95 font-medium">
                        <i class="fa-solid fa-equals mr-1"></i> Intra-State (Same)
                    </button>
                </div>

                <!-- State Selection with 1-Tap Swap for Mobile -->
                <div class="relative grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 items-center">
                    
                    <!-- Seller State -->
                    <div>
                        <label for="sellerState" class="block text-xs font-semibold text-slate-300 mb-1 flex items-center gap-1.5">
                            <i class="fa-solid fa-truck-ramp-box text-accentCyan text-xs"></i> Seller State (From)
                        </label>
                        <select id="sellerState" onchange="calculateTaxes()" class="w-full h-12 bg-slate-900 border border-carBorder rounded-xl px-3.5 text-slate-100 text-sm focus:outline-none focus:border-accentCyan transition cursor-pointer">
                            <option value="" disabled selected>Select Seller State</option>
                        </select>
                    </div>

                    <!-- Swap Button Floating (Mobile Optimized) -->
                    <div class="flex justify-center -my-2 sm:my-0 sm:absolute sm:left-1/2 sm:top-7 sm:-translate-x-1/2 z-10">
                        <button type="button" onclick="swapStates()" title="Swap States" aria-label="Swap States" class="w-9 h-9 rounded-full bg-slate-800 border border-carBorder text-accentCyan shadow-lg hover:bg-slate-700 active:rotate-180 transition-transform duration-300 flex items-center justify-center">
                            <i class="fa-solid fa-right-left text-xs rotate-90 sm:rotate-0"></i>
                        </button>
                    </div>

                    <!-- Buyer State -->
                    <div>
                        <label for="buyerState" class="block text-xs font-semibold text-slate-300 mb-1 flex items-center gap-1.5">
                            <i class="fa-solid fa-location-dot text-accentGreen text-xs"></i> Buyer State (To)
                        </label>
                        <select id="buyerState" onchange="calculateTaxes()" class="w-full h-12 bg-slate-900 border border-carBorder rounded-xl px-3.5 text-slate-100 text-sm focus:outline-none focus:border-accentCyan transition cursor-pointer">
                            <option value="" disabled selected>Select Buyer State</option>
                        </select>
                    </div>
                </div>

                <!-- Taxable Amount Input with Mobile Keypad Support -->
                <div>
                    <label for="taxableAmount" class="block text-xs font-semibold text-slate-300 mb-1 flex items-center gap-1.5">
                        <i class="fa-solid fa-indian-rupee-sign text-accentGreen"></i> Taxable Amount (Base Price)
                    </label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-lg pointer-events-none">₹</span>
                        <input type="number" inputmode="decimal" id="taxableAmount" value="50000" min="0" step="any" oninput="calculateTaxes()" placeholder="0.00" class="w-full h-14 bg-slate-900 border border-carBorder rounded-xl pl-10 pr-4 text-white text-xl sm:text-2xl font-bold tracking-wide focus:outline-none focus:border-accentGreen transition shadow-inner">
                    </div>
                </div>

                <!-- Tax Rates Mobile Adaptive Grid -->
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-2">Tax Rate Configuration (%)</label>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                        <!-- IGST Rate -->
                        <div id="igstContainer" class="bg-slate-900/80 border border-carBorder rounded-xl p-2.5 sm:p-3 transition">
                            <label class="block text-[11px] font-bold text-slate-400 mb-1">IGST (%)</label>
                            <input type="number" inputmode="decimal" id="igstRate" value="18" min="0" max="100" step="0.5" oninput="handleRateChange('igst')" class="w-full h-10 bg-slate-800 border border-slate-700 rounded-lg text-white font-bold text-center text-sm focus:outline-none focus:border-accentCyan">
                        </div>
                        <!-- CGST Rate -->
                        <div id="cgstContainer" class="bg-slate-900/80 border border-carBorder rounded-xl p-2.5 sm:p-3 transition opacity-50">
                            <label class="block text-[11px] font-bold text-slate-400 mb-1">CGST (%)</label>
                            <input type="number" inputmode="decimal" id="cgstRate" value="9" min="0" max="100" step="0.5" oninput="handleRateChange('cgst')" disabled class="w-full h-10 bg-slate-800 border border-slate-700 rounded-lg text-white font-bold text-center text-sm focus:outline-none focus:border-accentCyan cursor-not-allowed">
                        </div>
                        <!-- SGST Rate -->
                        <div id="sgstContainer" class="bg-slate-900/80 border border-carBorder rounded-xl p-2.5 sm:p-3 transition opacity-50">
                            <label class="block text-[11px] font-bold text-slate-400 mb-1">SGST (%)</label>
                            <input type="number" inputmode="decimal" id="sgstRate" value="9" min="0" max="100" step="0.5" oninput="handleRateChange('sgst')" disabled class="w-full h-10 bg-slate-800 border border-slate-700 rounded-lg text-white font-bold text-center text-sm focus:outline-none focus:border-accentCyan cursor-not-allowed">
                        </div>
                        <!-- TDS Rate -->
                        <div class="bg-slate-900/80 border border-carBorder rounded-xl p-2.5 sm:p-3">
                            <label class="block text-[11px] font-bold text-slate-400 mb-1">TDS (%)</label>
                            <input type="number" inputmode="decimal" id="tdsRate" value="2" min="0" max="100" step="0.1" oninput="calculateTaxes()" class="w-full h-10 bg-slate-800 border border-slate-700 rounded-lg text-white font-bold text-center text-sm focus:outline-none focus:border-accentOrange">
                        </div>
                    </div>
                </div>

                <!-- Quick Slabs Buttons (Touch Friendly) -->
                <div class="pt-2">
                    <span class="block text-[11px] font-semibold text-slate-400 mb-2">Automotive GST Slabs:</span>
                    <div class="grid grid-cols-4 gap-2">
                        <button type="button" onclick="setTaxSlab(5)" class="h-10 bg-slate-900 hover:bg-slate-800 active:bg-accentCyan/20 active:border-accentCyan border border-carBorder rounded-xl text-xs font-bold text-slate-300 transition active:scale-95 cursor-pointer">5%</button>
                        <button type="button" onclick="setTaxSlab(12)" class="h-10 bg-slate-900 hover:bg-slate-800 active:bg-accentCyan/20 active:border-accentCyan border border-carBorder rounded-xl text-xs font-bold text-slate-300 transition active:scale-95 cursor-pointer">12%</button>
                        <button type="button" onclick="setTaxSlab(18)" class="h-10 bg-slate-900 hover:bg-slate-800 active:bg-accentCyan/20 active:border-accentCyan border border-carBorder rounded-xl text-xs font-bold text-slate-300 transition active:scale-95 cursor-pointer">18%</button>
                        <button type="button" onclick="setTaxSlab(28)" class="h-10 bg-slate-900 hover:bg-slate-800 active:bg-accentCyan/20 active:border-accentCyan border border-carBorder rounded-xl text-xs font-bold text-slate-300 transition active:scale-95 cursor-pointer">28%</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Right Panel: Calculation Breakdown & Grand Total (5 cols) -->
        <section id="summarySection" class="lg:col-span-5 bg-carCard border border-carBorder rounded-2xl p-4 sm:p-6 shadow-xl flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-3 border-b border-carBorder mb-4">
                    <h2 class="text-sm sm:text-base font-semibold text-white flex items-center gap-2">
                        <i class="fa-solid fa-file-invoice-dollar text-accentGreen"></i> Invoice Summary
                    </h2>
                    <span id="taxModeBadge" class="text-xs px-2.5 py-1 rounded-lg bg-accentCyan/10 text-accentCyan border border-accentCyan/30 font-bold">IGST Applied</span>
                </div>

                <!-- Summary Line Items -->
                <div class="space-y-2.5 mb-5 text-sm">
                    <div class="flex justify-between items-center py-2.5 px-3.5 bg-slate-900/70 rounded-xl border border-carBorder">
                        <span class="text-slate-400 font-medium">Taxable Base</span>
                        <span id="outTaxable" class="font-bold text-white tracking-wide">₹0.00</span>
                    </div>

                    <!-- IGST Dynamic Row -->
                    <div id="rowIgst" class="flex justify-between items-center py-2.5 px-3.5 bg-slate-900/70 rounded-xl border border-carBorder">
                        <span id="labelIgst" class="text-slate-400 font-medium">IGST (18%)</span>
                        <span id="outIgst" class="font-bold text-accentCyan tracking-wide">₹0.00</span>
                    </div>

                    <!-- CGST + SGST Rows -->
                    <div id="rowCgstSgst" class="hidden space-y-2.5">
                        <div class="flex justify-between items-center py-2.5 px-3.5 bg-slate-900/70 rounded-xl border border-carBorder">
                            <span id="labelCgst" class="text-slate-400 font-medium">CGST (9%)</span>
                            <span id="outCgst" class="font-bold text-accentCyan tracking-wide">₹0.00</span>
                        </div>
                        <div class="flex justify-between items-center py-2.5 px-3.5 bg-slate-900/70 rounded-xl border border-carBorder">
                            <span id="labelSgst" class="text-slate-400 font-medium">SGST (9%)</span>
                            <span id="outSgst" class="font-bold text-accentCyan tracking-wide">₹0.00</span>
                        </div>
                    </div>

                    <div class="flex justify-between items-center py-2.5 px-3.5 bg-slate-900 rounded-xl border border-slate-700/80 font-semibold">
                        <span class="text-slate-300">Total Invoice (GST Inc.)</span>
                        <span id="outTotal" class="font-extrabold text-white text-base tracking-wide">₹0.00</span>
                    </div>

                    <div class="flex justify-between items-center py-2.5 px-3.5 bg-slate-900/70 rounded-xl border border-carBorder">
                        <span id="labelTds" class="text-accentOrange font-medium">Less: TDS (2%)</span>
                        <span id="outTds" class="font-bold text-accentOrange tracking-wide">- ₹0.00</span>
                    </div>
                </div>
            </div>

            <!-- Net Payable Box -->
            <div class="bg-gradient-to-br from-slate-900 via-slate-950 to-carDark border border-accentGreen/40 rounded-2xl p-4 sm:p-5 shadow-neon-green relative overflow-hidden">
                <div class="absolute -right-4 -bottom-4 text-accentGreen/10 text-8xl pointer-events-none">
                    <i class="fa-solid fa-wallet"></i>
                </div>
                <div class="text-[11px] uppercase tracking-wider text-accentGreen font-bold mb-1 flex items-center gap-1.5">
                    <i class="fa-solid fa-circle-check"></i> Net Payable Amount
                </div>
                <div id="outNetPayable" class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight mb-4">
                    ₹0.00
                </div>

                <button type="button" onclick="printInvoiceSummary()" class="w-full h-12 bg-accentGreen hover:bg-emerald-500 active:scale-98 text-slate-950 font-bold rounded-xl shadow-lg shadow-accentGreen/20 transition flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-file-invoice"></i> View & Print Summary
                </button>
            </div>
        </section>

    </main>

    <!-- Mobile Docked Sticky Bar (Appears on mobile screens) -->
    <aside id="mobileStickyBar" class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-carCard/95 backdrop-blur-xl border-t border-carBorder p-3 px-4 shadow-[0_-5px_25px_rgba(0,0,0,0.5)] flex items-center justify-between gap-3">
        <div class="leading-tight">
            <span class="text-[10px] uppercase font-bold text-accentGreen tracking-wide block">Net Payable</span>
            <span id="mobileNetPayable" class="text-lg font-black text-white tracking-tight">₹0.00</span>
        </div>
        <button type="button" onclick="printInvoiceSummary()" class="h-10 px-4 bg-accentGreen text-slate-950 font-bold text-xs rounded-xl flex items-center gap-2 active:scale-95 shadow-md shadow-accentGreen/20">
            <i class="fa-solid fa-print"></i> Details
        </button>
    </aside>

    <!-- Footer -->
    <footer class="w-full text-center text-xs text-slate-500 mt-6 pt-4 border-t border-carBorder flex flex-col sm:flex-row items-center justify-between gap-2">
        <div class="flex items-center gap-2">
            <span class="font-bold text-slate-400">AUTOTAX</span> • Built for Automotive Dealerships & Fleets
        </div>
        <div class="flex items-center gap-4 text-[11px] text-slate-400">
            <span><i class="fa-solid fa-shield-halved text-accentGreen"></i> GST Rule 2026 Ready</span>
            <span><i class="fa-solid fa-bolt text-accentCyan"></i> Instant Re-calc</span>
        </div>
    </footer>

    <!-- Modal for Preview & Printing -->
    <div id="customModal" class="fixed inset-0 bg-black/85 backdrop-blur-sm z-50 hidden flex items-center justify-center p-3 sm:p-4">
        <div class="bg-carCard border border-carBorder rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-2xl relative animate-in fade-in zoom-in duration-200">
            <div class="flex items-center justify-between pb-3 border-b border-carBorder mb-4">
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-receipt text-accentCyan"></i> Tax Breakdown Receipt
                </h3>
                <button type="button" onclick="closeModal()" aria-label="Close Modal" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            
            <div id="modalBody" class="text-xs sm:text-sm text-slate-300 space-y-3 mb-5 max-h-[60vh] overflow-y-auto">
                <!-- Dynamically loaded -->
            </div>

            <div class="flex gap-2.5">
                <button type="button" onclick="executePrint()" class="flex-1 h-11 bg-accentCyan hover:bg-cyan-400 text-slate-950 font-bold rounded-xl transition flex items-center justify-center gap-2 text-xs sm:text-sm cursor-pointer">
                    <i class="fa-solid fa-print"></i> Print Receipt
                </button>
                <button type="button" onclick="closeModal()" class="px-5 h-11 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-xl transition text-xs sm:text-sm cursor-pointer">
                    Close
                </button>
            </div>
        </div>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        // Full GST State & UT Master List
        const INDIAN_STATES = [
            "Andhra Pradesh", "Arunachal Pradesh", "Assam", "Bihar", "Chhattisgarh",
            "Goa", "Gujarat", "Haryana", "Himachal Pradesh", "Jharkhand",
            "Karnataka", "Kerala", "Madhya Pradesh", "Maharashtra", "Manipur",
            "Meghalaya", "Mizoram", "Nagaland", "Odisha", "Punjab",
            "Rajasthan", "Sikkim", "Tamil Nadu", "Telangana", "Tripura",
            "Uttar Pradesh", "Uttarakhand", "West Bengal",
            // Union Territories
            "Andaman and Nicobar Islands", "Chandigarh", "Dadra & Nagar Haveli and Daman & Diu",
            "Delhi", "Jammu and Kashmir", "Ladakh", "Lakshadweep", "Puducherry"
        ];

        window.onload = function() {
            populateStateDropdowns();
            document.getElementById('sellerState').value = "Maharashtra";
            document.getElementById('buyerState').value = "Delhi";
            calculateTaxes();
        };

        function populateStateDropdowns() {
            const sellerSelect = document.getElementById('sellerState');
            const buyerSelect = document.getElementById('buyerState');
            
            INDIAN_STATES.forEach(state => {
                const opt1 = new Option(state, state);
                const opt2 = new Option(state, state);
                sellerSelect.add(opt1);
                buyerSelect.add(opt2);
            });
        }

        function swapStates() {
            const seller = document.getElementById('sellerState');
            const buyer = document.getElementById('buyerState');
            const temp = seller.value;
            seller.value = buyer.value;
            buyer.value = temp;
            triggerHaptic();
            calculateTaxes();
        }

        function setSameStateQuick() {
            const seller = document.getElementById('sellerState');
            const buyer = document.getElementById('buyerState');
            if (seller.value) {
                buyer.value = seller.value;
            } else if (buyer.value) {
                seller.value = buyer.value;
            } else {
                seller.value = "Maharashtra";
                buyer.value = "Maharashtra";
            }
            triggerHaptic();
            calculateTaxes();
        }

        function setTaxSlab(rate) {
            document.getElementById('igstRate').value = rate;
            document.getElementById('cgstRate').value = (rate / 2).toFixed(1);
            document.getElementById('sgstRate').value = (rate / 2).toFixed(1);
            triggerHaptic();
            calculateTaxes();
        }

        function handleRateChange(type) {
            if (type === 'igst') {
                const igst = parseFloat(document.getElementById('igstRate').value) || 0;
                document.getElementById('cgstRate').value = (igst / 2).toFixed(1);
                document.getElementById('sgstRate').value = (igst / 2).toFixed(1);
            } else if (type === 'cgst' || type === 'sgst') {
                const cgst = parseFloat(document.getElementById('cgstRate').value) || 0;
                const sgst = parseFloat(document.getElementById('sgstRate').value) || 0;
                document.getElementById('igstRate').value = (cgst + sgst).toFixed(1);
            }
            calculateTaxes();
        }

        function calculateTaxes() {
            const seller = document.getElementById('sellerState').value;
            const buyer = document.getElementById('buyerState').value;
            const taxable = parseFloat(document.getElementById('taxableAmount').value) || 0;
            const tdsRate = parseFloat(document.getElementById('tdsRate').value) || 0;

            const statusDot = document.getElementById('statusDot');
            const statusText = document.getElementById('statusText');
            const taxModeBadge = document.getElementById('taxModeBadge');

            if (!seller || !buyer) {
                statusDot.className = "w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse";
                statusText.innerText = "Select States";
                return;
            }

            statusDot.className = "w-2.5 h-2.5 rounded-full bg-accentGreen";
            const isSameState = (seller === buyer);

            const rowIgst = document.getElementById('rowIgst');
            const rowCgstSgst = document.getElementById('rowCgstSgst');

            const igstRate = parseFloat(document.getElementById('igstRate').value) || 0;
            const cgstRate = parseFloat(document.getElementById('cgstRate').value) || 0;
            const sgstRate = parseFloat(document.getElementById('sgstRate').value) || 0;

            let taxAmount = 0;
            let igstAmt = 0;
            let cgstAmt = 0;
            let sgstAmt = 0;

            if (isSameState) {
                statusText.innerText = "Intra-State";
                taxModeBadge.innerText = "CGST + SGST";
                taxModeBadge.className = "text-xs px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold";

                rowIgst.classList.add('hidden');
                rowCgstSgst.classList.remove('hidden');

                cgstAmt = (taxable * cgstRate) / 100;
                sgstAmt = (taxable * sgstRate) / 100;
                taxAmount = cgstAmt + sgstAmt;

                document.getElementById('labelCgst').innerText = `CGST (${cgstRate}%)`;
                document.getElementById('labelSgst').innerText = `SGST (${sgstRate}%)`;
                document.getElementById('outCgst').innerText = formatCurrency(cgstAmt);
                document.getElementById('outSgst').innerText = formatCurrency(sgstAmt);
            } else {
                statusText.innerText = "Inter-State";
                taxModeBadge.innerText = "IGST Applied";
                taxModeBadge.className = "text-xs px-2.5 py-1 rounded-lg bg-accentCyan/10 text-accentCyan border border-accentCyan/30 font-bold";

                rowIgst.classList.remove('hidden');
                rowCgstSgst.classList.add('hidden');

                igstAmt = (taxable * igstRate) / 100;
                taxAmount = igstAmt;

                document.getElementById('labelIgst').innerText = `IGST (${igstRate}%)`;
                document.getElementById('outIgst').innerText = formatCurrency(igstAmt);
            }

            const totalAmount = taxable + taxAmount;
            const tdsAmount = (taxable * tdsRate) / 100;
            const netPayable = totalAmount - tdsAmount;

            // Render Output values
            document.getElementById('outTaxable').innerText = formatCurrency(taxable);
            document.getElementById('outTotal').innerText = formatCurrency(totalAmount);
            document.getElementById('labelTds').innerText = `Less: TDS (${tdsRate}%)`;
            document.getElementById('outTds').innerText = `- ${formatCurrency(tdsAmount)}`;
            
            const formattedNet = formatCurrency(netPayable);
            document.getElementById('outNetPayable').innerText = formattedNet;
            document.getElementById('mobileNetPayable').innerText = formattedNet;
        }

        function formatCurrency(amount) {
            return '₹' + amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function triggerHaptic() {
            if (navigator.vibrate) {
                navigator.vibrate(12);
            }
        }

        function resetCalculator() {
            triggerHaptic();
            document.getElementById('sellerState').value = "";
            document.getElementById('buyerState').value = "";
            document.getElementById('taxableAmount').value = "50000";
            document.getElementById('igstRate').value = "18";
            document.getElementById('cgstRate').value = "9";
            document.getElementById('sgstRate').value = "9";
            document.getElementById('tdsRate').value = "2";
            calculateTaxes();
        }

        function printInvoiceSummary() {
            triggerHaptic();
            const seller = document.getElementById('sellerState').value || 'Not Selected';
            const buyer = document.getElementById('buyerState').value || 'Not Selected';
            const taxable = document.getElementById('outTaxable').innerText;
            const total = document.getElementById('outTotal').innerText;
            const tds = document.getElementById('outTds').innerText;
            const netPayable = document.getElementById('outNetPayable').innerText;
            const taxMode = document.getElementById('taxModeBadge').innerText;

            let taxDetailsHTML = '';
            if (seller === buyer && seller !== 'Not Selected') {
                taxDetailsHTML = `
                    <div class="flex justify-between py-1"><span>CGST:</span> <span class="font-bold text-white">${document.getElementById('outCgst').innerText}</span></div>
                    <div class="flex justify-between py-1"><span>SGST:</span> <span class="font-bold text-white">${document.getElementById('outSgst').innerText}</span></div>
                `;
            } else {
                taxDetailsHTML = `
                    <div class="flex justify-between py-1"><span>IGST:</span> <span class="font-bold text-white">${document.getElementById('outIgst').innerText}</span></div>
                `;
            }

            const modalBody = document.getElementById('modalBody');
            modalBody.innerHTML = `
                <div class="bg-slate-900/90 p-4 rounded-xl border border-slate-800 space-y-2">
                    <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-400 pb-2.5 border-b border-slate-800">
                        <div>Seller (Origin):<br><strong class="text-white text-xs">${seller}</strong></div>
                        <div>Buyer (Dest):<br><strong class="text-white text-xs">${buyer}</strong></div>
                    </div>
                    <div class="flex justify-between py-1"><span>Tax Regime:</span> <span class="font-bold text-accentCyan">${taxMode}</span></div>
                    <div class="flex justify-between py-1"><span>Taxable Base:</span> <span class="font-bold text-white">${taxable}</span></div>
                    ${taxDetailsHTML}
                    <div class="flex justify-between py-2 border-t border-slate-800 font-bold"><span>Total Invoice:</span> <span class="text-white">${total}</span></div>
                    <div class="flex justify-between py-1 text-accentOrange"><span>TDS Deduction:</span> <span class="font-bold">${tds}</span></div>
                    <div class="flex justify-between pt-2.5 border-t border-slate-800 text-base font-extrabold text-accentGreen">
                        <span>Net Receivable:</span> <span>${netPayable}</span>
                    </div>
                </div>
            `;

            document.getElementById('customModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('customModal').classList.add('hidden');
        }

        function executePrint() {
            window.print();
        }
    </script>
</body>
</html>